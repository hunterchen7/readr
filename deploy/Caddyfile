{$DOMAIN:localhost} {
  # API + health on dedicated prefixes; everything else goes to the
  # Expo Web nginx service so the web client of apps/mobile can be
  # served from the same origin as the API.
  handle /api/* {
    reverse_proxy api:3000
  }
  handle /health {
    reverse_proxy api:3000
  }
  handle {
    reverse_proxy web:80
  }
}
