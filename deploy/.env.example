# deploy/.env.example
#
# Template for the production `.env` that lives at the repo root on the
# Olares box (i.e. ~/readr/.env). Copy this file there and fill in the
# placeholders:
#
#   scp deploy/.env.example olares-ebook:~/readr/.env
#   ssh olares-ebook "$EDITOR ~/readr/.env"
#
# Both compose stacks (deploy/docker-compose.infra.yml and
# deploy/docker-compose.app.yml) read this file via `env_file: ../.env`.
# There are NO compose-file defaults to fall back on — every variable
# below must be set, or the relevant container will refuse to boot.

# === Postgres ===
# Read directly by the postgres image to initialize the cluster on
# first boot. The api container reads DATABASE_URL (below) instead.
POSTGRES_USER=reader
POSTGRES_PASSWORD=change-me-to-a-strong-secret
POSTGRES_DB=reader

# === API connection strings (in-network) ===
# Hostnames here are Docker Compose service names on the shared `readr`
# network — postgres:5432 and redis:6379 — NOT host LAN addresses.
# DATABASE_URL must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above.
DATABASE_URL=postgresql://reader:change-me-to-a-strong-secret@postgres:5432/reader
REDIS_URL=redis://redis:6379

# === S3-compatible storage ===
# Two modes — pick exactly one block and delete the other.
#
# ----- Mode A: Bundled MinIO (docker compose --profile local-s3) -----
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD are read by both the minio
# server and the minio-init bucket-bootstrap one-shot.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-to-a-strong-secret
S3_ENDPOINT=http://minio:9000
S3_BUCKET=reader-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-to-a-strong-secret
S3_REGION=auto
# MinIO requires path-style addressing.
S3_FORCE_PATH_STYLE=true
# Externally-reachable URL clients hit for presigned downloads. Must be
# path-style (no bucket name in the hostname). For Mode A this is the
# Cloudflare tunnel hostname pointing at the minio container's :9000.
S3_PUBLIC_ENDPOINT=https://books.example.com
#
# ----- Mode B: External S3 (Cloudflare R2 / AWS S3 / B2 / DO Spaces) -----
# Uncomment and fill these instead of the Mode A block above. Skip the
# `--profile local-s3` flag when bringing up the infra stack so the
# bundled MinIO and minio-init never start.
#
# # AWS S3:
# # S3_ENDPOINT is intentionally omitted — the SDK resolves the regional
# # endpoint from S3_REGION when no endpoint is set. Setting it pins the
# # client to that host.
# S3_BUCKET=my-readr-books
# S3_ACCESS_KEY=AKIA...
# S3_SECRET_KEY=...
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=false
# # Path-style URL: https://s3.<region>.amazonaws.com (NO bucket in host).
# # The api concatenates /<bucket>/<key> at URL-generation time.
# S3_PUBLIC_ENDPOINT=https://s3.us-east-1.amazonaws.com
#
# # Cloudflare R2:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=my-readr-books
# S3_ACCESS_KEY=<r2-access-key-id>
# S3_SECRET_KEY=<r2-secret>
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_ENDPOINT=https://books.example.com  # R2 custom domain or *.r2.dev

# === App config ===
PUBLIC_URL=https://api.reader.example.com
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
MAX_UPLOAD_SIZE_MB=500
DEFAULT_STORAGE_QUOTA_MB=4096

# === TTS (optional) ===
TTS_ENABLED=false

# === Email recovery (optional) ===
# Both must be set to enable the /api/email/* routes. Leave unset to
# disable the whole feature.
# RESEND_API_KEY=re_...
# RESEND_FROM=Readr <readr@reader.example.com>
