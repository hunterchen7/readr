FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate
# poppler-utils → pdftoppm for PDF page-1 cover rendering.
# Alpine's minimal poppler package is ~8 MB, worth it for real book covers.
RUN apk add --no-cache poppler-utils
WORKDIR /app

# Install all workspace dependencies (including tsx, which we use to run TS directly).
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY packages/sync-engine/package.json packages/sync-engine/
COPY apps/server/package.json apps/server/
RUN pnpm install --frozen-lockfile --prod=false

# Ship the source directly — packages/shared and packages/sync-engine export
# ./src/index.ts via their package.json "main"/"exports", so tsx resolves them
# at import time without any pre-compile step. Matches `pnpm dev` behavior exactly.
FROM deps AS production
COPY tsconfig.base.json ./
COPY packages/shared/ packages/shared/
COPY packages/sync-engine/ packages/sync-engine/
COPY apps/server/ apps/server/

ENV NODE_ENV=production
EXPOSE 3000

WORKDIR /app/apps/server
CMD ["pnpm", "exec", "tsx", "src/index.ts"]
