FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.27.0 --activate
# poppler-utils → pdftoppm for PDF page-1 cover rendering.
RUN apk add --no-cache poppler-utils
WORKDIR /app

# Install all workspace deps (including tsx). tsx is needed at runtime
# because workspace packages (shared, sync-engine) export raw .ts via
# their package.json "main" field. tsx's esbuild-based loader adds
# ~200ms cold start — acceptable for a self-hosted app. To eliminate
# it, change the workspace packages to export compiled JS.
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY packages/sync-engine/package.json packages/sync-engine/
COPY apps/server/package.json apps/server/
RUN pnpm install --frozen-lockfile --prod=false

FROM deps AS production
COPY tsconfig.base.json ./
COPY packages/shared/ packages/shared/
COPY packages/sync-engine/ packages/sync-engine/
COPY apps/server/ apps/server/

ENV NODE_ENV=production
EXPOSE 3000

WORKDIR /app/apps/server
CMD ["pnpm", "exec", "tsx", "src/index.ts"]
