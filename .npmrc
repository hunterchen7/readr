# Hoist all transitive deps into the root node_modules so the React Native
# bundler (Metro) can resolve nested peer dependencies like whatwg-fetch,
# @expo/metro-runtime, etc. that come from deep inside expo-router.
# Keep the default "isolated" node-linker so each workspace package still
# gets its own node_modules with symlinks — Metro + expo autolinking rely on
# that per-package layout.
shamefully-hoist=true
public-hoist-pattern[]=*
