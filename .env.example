# === Database ===
DATABASE_URL=postgresql://reader:password@localhost:5432/reader

# === Redis ===
REDIS_URL=redis://localhost:6379

# === S3-Compatible Storage (Cloudflare R2) ===
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=reader-files
S3_ACCESS_KEY=<r2-access-key-id>
S3_SECRET_KEY=<r2-secret-access-key>
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# === Auth (better-auth) ===
BETTER_AUTH_SECRET=<random-32-char-string>
BETTER_AUTH_URL=http://localhost:3000
PUBLIC_URL=http://localhost
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost,http://localhost:8080,http://localhost:5173,exp://localhost:8081

# === TTS Worker ===
TTS_ENABLED=true
TTS_DEFAULT_ENGINE=chatterbox-turbo
TTS_MODEL_DIR=/models
TTS_STREAM_ENGINE=kokoro

# === App Config ===
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
MAX_UPLOAD_SIZE_MB=500
DEFAULT_STORAGE_QUOTA_MB=1024
