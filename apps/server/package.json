{
  "name": "@readr/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@hono/node-server": "^1",
    "@readr/shared": "workspace:*",
    "@readr/sync-engine": "workspace:*",
    "bullmq": "^5",
    "drizzle-orm": "^0.41",
    "fast-xml-parser": "^5.5.11",
    "hono": "^4",
    "ioredis": "^5",
    "jszip": "^3.10.1",
    "pdf-parse": "^2.4.5",
    "postgres": "^3",
    "resend": "^6.10.0",
    "sharp": "^0.33",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pdf-parse": "^1.1.5",
    "drizzle-kit": "^0.31",
    "tsx": "^4",
    "typescript": "~5.6"
  }
}
