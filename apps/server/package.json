{
  "name": "@readr/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@readr/shared": "workspace:*",
    "@readr/sync-engine": "workspace:*",
    "hono": "^4",
    "@hono/node-server": "^1",
    "better-auth": "^1",
    "drizzle-orm": "^0.41",
    "postgres": "^3",
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "zod": "^3",
    "sharp": "^0.33",
    "bullmq": "^5",
    "ioredis": "^5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31",
    "tsx": "^4",
    "typescript": "~5.6",
    "@types/node": "^22"
  }
}
